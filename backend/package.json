{
  "name": "cruizy-backend",
  "version": "0.6.0",
  "private": true,
  "description": "Cruizy – Server (API, Echtzeit, Hintergrundaufträge)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "migrate:down": "tsx src/db/migrate-cli.ts down",
    "seed:test": "tsx src/seed/testdaten.ts",
    "staff:create": "tsx src/cli/staff-create.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check:deps": "node scripts/check-deps.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.3.1",
    "@simplewebauthn/server": "^13.3.3",
    "archiver": "^7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.12",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
