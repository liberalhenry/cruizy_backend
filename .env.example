# ─────────────────────────────────────────────────────────────────────────────
# Einstellungen für den Betrieb auf dem VPS. Kopieren nach .env und ausfüllen.
# deploy/install.sh erzeugt die Geheimnisse automatisch.
# ─────────────────────────────────────────────────────────────────────────────

# Adressen. Zwei getrennte (Sub-)Domains: App und Moderationswerkzeug (M00).
# Beide müssen per DNS (A/AAAA) auf den Server zeigen, dann holt Caddy die Zertifikate selbst.
APP_ADDRESS=app.example.de
MOD_ADDRESS=werkzeug.example.de
APP_URL=https://app.example.de
MOD_URL=https://werkzeug.example.de
ACME_EMAIL=technik@example.de

# Datenbank (nur im internen Docker-Netz erreichbar)
POSTGRES_PASSWORD=

# Hauptschlüssel, 32 Byte Base64 (openssl rand -base64 32).
# Aus ihm werden alle Teilschlüssel abgeleitet. OHNE IHN SIND DIE DATEN VERLOREN —
# getrennt von den Sicherungen aufbewahren.
MASTER_KEY=

# Betrieb: test = nur erfundene Daten, Registrierung nur mit Einladungscode.
# live startet erst, wenn nichts mehr auf Attrappen läuft und der Hash-Abgleich
# angebunden ist (AK-M02-11). Der Server nennt beim Start, was noch fehlt.
OPERATION_MODE=test
TEST_INVITE_CODE=

# Cookies nur über HTTPS (Voreinstellung). Nur für lokale Tests ohne TLS auf 0.
COOKIE_SECURE=1

# E-Mail über einen Dienst mit Sitz in der EU (SMTP). Leer = nur im Protokoll (Testbetrieb).
# Beispiel Sweego: smtps://BENUTZER:PASSWORT@smtp.sweego.io:465  (Zugangsdaten aus dem Sweego-Konto)
SMTP_URL=
MAIL_FROM="Benachrichtigung <no-reply@example.de>"

# SMS: log (nur Testbetrieb) oder http (beliebiger EU-Dienst per JSON-POST).
# {to}, {text} und {sender} werden ersetzt. Vorlage für Sweego — Feldnamen vor dem Start
# mit der Sweego-Dokumentation abgleichen:
#   SMS_HTTP_URL=https://api.sweego.io/send
#   SMS_HTTP_HEADERS={"Api-Key":"DEIN_SCHLUESSEL"}
#   SMS_HTTP_BODY={"channel":"sms","provider":"sweego","recipients":[{"num":"{to}"}],"message-txt":"{text}","sender":"{sender}"}
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_HTTP_HEADERS={}
SMS_HTTP_BODY=
SMS_SENDER=Info

# Anmelden mit Apple (leer = ausgeblendet)
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# Web-Push: leer = Schlüssel werden beim ersten Start erzeugt und verschlüsselt gespeichert
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:technik@example.de

# Altersprüfung: bisher nur die Attrappe (mock). Ein echter Prüfpartner wird hier angebunden.
AGE_PROVIDER=mock
AGE_WEBHOOK_SECRET=

# Prüfkette öffentlicher Profilbilder (M-02):
#   queue = jedes Bild geht an einen Menschen (sichere Voreinstellung)
#   http  = selbst gehosteter Klassifikator unter CLASSIFIER_URL
CLASSIFIER=queue
CLASSIFIER_URL=
# Hash-Abgleich: none | http (Abgleichdienst, POST {hash, media?} → {hit, list}). mock nur im Testbetrieb.
HASH_PROVIDER=none
HASH_URL=
HASH_HEADERS={}
HASH_TRANSFER=hash

# Eingang termine@ (Webhook des Maildienstes, F34)
INBOUND_MAIL_SECRET=

# Wochenzusammenfassung des Zugriffsprotokolls an beide Gründer (kommagetrennt)
MOD_REPORT_MAIL=

# Karte „Heute“: eigener oder EU-Kachelserver. Leer = schematische Karte ohne Dritte.
# MAP_TILE_ORIGIN muss zum Host von MAP_TILE_URL passen (für die Sicherheitsrichtlinie).
MAP_TILE_URL=
MAP_ATTRIBUTION=
MAP_TILE_ORIGIN=

LOG_LEVEL=info

# Sicherungen (deploy/backup.sh): Passwort für die Verschlüsselung der Sicherungsdateien
BACKUP_PASSPHRASE=
