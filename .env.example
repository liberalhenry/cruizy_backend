# ─────────────────────────────────────────────────────────────────────────────
# Einstellungen für den Betrieb auf dem VPS. Kopieren nach .env und ausfüllen.
# deploy/install.sh erzeugt die Geheimnisse automatisch.
# ─────────────────────────────────────────────────────────────────────────────

# Adressen. Zwei getrennte (Sub-)Domains: App und Moderationswerkzeug (M00).
# Beide müssen per DNS (A/AAAA) auf den Server zeigen, dann holt Caddy die Zertifikate selbst.
APP_ADDRESS=app.example.de
MOD_ADDRESS=werkzeug.example.de
APP_URL=https://app.example.de
MOD_URL=https://werkzeug.example.de
ACME_EMAIL=technik@example.de

# Datenbank (nur im internen Docker-Netz erreichbar)
POSTGRES_PASSWORD=

# Hauptschlüssel, 32 Byte Base64 (openssl rand -base64 32).
# Aus ihm werden alle Teilschlüssel abgeleitet. OHNE IHN SIND DIE DATEN VERLOREN —
# getrennt von den Sicherungen aufbewahren.
MASTER_KEY=

# Betrieb: test = nur erfundene Daten, Registrierung nur mit Einladungscode.
# live startet erst, wenn nichts mehr auf Attrappen läuft und der Hash-Abgleich
# angebunden ist (AK-M02-11). Der Server nennt beim Start, was noch fehlt.
OPERATION_MODE=test
TEST_INVITE_CODE=

# Cookies nur über HTTPS (Voreinstellung). Nur für lokale Tests ohne TLS auf 0.
COOKIE_SECURE=1

# E-Mail über einen Dienst mit Sitz in der EU (SMTP). Leer = nur im Protokoll (Testbetrieb).
# Beispiel Sweego: smtps://BENUTZER:PASSWORT@smtp.sweego.io:465  (Zugangsdaten aus dem Sweego-Konto)
SMTP_URL=
MAIL_FROM="Benachrichtigung <no-reply@example.de>"
# Gestaltung der Mails (HTML im Corporate Design, siehe shared/brand/README.md):
#   voll   = mit Logo im Kopf    dezent = gleiche Gestaltung ohne Logo und ohne Namen
# Betreff und Vorschauzeile nennen in beiden Fällen weder Produkt noch Anlass.
MAIL_BRANDING=voll

# Telegram-Bot statt SMS (Issue #32): Codes an Telefonnummern und — auf Wunsch — Mitteilungen.
# Bot bei @BotFather anlegen (/newbot), Token und Benutzernamen (ohne @) hier eintragen.
#   log     = nur Protokoll (nur Testbetrieb)
#   polling = der Server holt Nachrichten an den Bot selbst ab — nichts weiter einzurichten
#   webhook = Telegram liefert an https://<APP_ADDRESS>/api/telegram/webhook; dann ist
#             TELEGRAM_WEBHOOK_SECRET Pflicht (mind. 16 Zeichen, nur A-Z a-z 0-9 _ -)
# Tipp: Bot-Name und Beschreibung neutral halten (ohne Produktnamen) — er steht im Telegram der Person.
TELEGRAM_MODE=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_WEBHOOK_SECRET=

# Anmelden mit Apple (leer = ausgeblendet)
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# Web-Push: leer = Schlüssel werden beim ersten Start erzeugt und verschlüsselt gespeichert
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:technik@example.de

# Altersprüfung (Issue #7):
#   ausweis = Foto des Ausweises, unser Server liest NUR das Geburtsdatum (Texterkennung lokal,
#             kein Dritter). Sicher volljährig → sofort frei, kein Bild bleibt. Unsicher oder
#             unter 18 → ein Mensch prüft im Werkzeug („Altersprüfung“), danach werden die Bilder
#             gelöscht. Fristen: P-AUSWEIS-FRIST, P-AUSWEIS-AUFBEWAHRUNG (Werkzeug → Verwaltung).
#   mock    = Attrappe eines Prüfpartners (nur Testbetrieb)
AGE_PROVIDER=ausweis
AGE_WEBHOOK_SECRET=

# Prüfkette öffentlicher Profilbilder (M-02):
#   queue = jedes Bild geht an einen Menschen (sichere Voreinstellung)
#   http  = selbst gehosteter Klassifikator unter CLASSIFIER_URL
CLASSIFIER=queue
CLASSIFIER_URL=
# Hash-Abgleich: none | http (Abgleichdienst, POST {hash, media?} → {hit, list}). mock nur im Testbetrieb.
HASH_PROVIDER=none
HASH_URL=
HASH_HEADERS={}
HASH_TRANSFER=hash

# Eingang termine@ (Webhook des Maildienstes, F34)
INBOUND_MAIL_SECRET=

# Wochenzusammenfassung des Zugriffsprotokolls an beide Gründer (kommagetrennt)
MOD_REPORT_MAIL=

# Karte „Heute“ (Issue #17) — ohne Google oder US-Dienste. Drei Möglichkeiten, die erste gesetzte gilt:
#  1. MAP_TILE_URL: eigener Kachelserver, die Geräte laden direkt dort.
#     MAP_TILE_ORIGIN muss zum Host von MAP_TILE_URL passen (für die Sicherheitsrichtlinie).
#  2. MAP_TILE_UPSTREAM: EU-Kachelserver, abgerufen über unseren Server (mit Zwischenspeicher).
#     Beispiel: https://tile.openstreetmap.de/{z}/{x}/{y}.png (FOSSGIS e. V.) — Nutzungsregeln des
#     Anbieters beachten; bei viel Verkehr einen eigenen Kachelserver oder einen bezahlten EU-Dienst nehmen.
#  3. Beides leer: Grundkarte aus mitgelieferten Daten (Ländergrenzen und Ortsnamen), nichts geht an Dritte.
MAP_TILE_URL=
MAP_ATTRIBUTION=
MAP_TILE_ORIGIN=
MAP_TILE_UPSTREAM=
MAP_TILE_UPSTREAM_ATTRIBUTION=© OpenStreetMap-Mitwirkende

# Discord-Webhooks (Issue #6): Ereignisse zum Nachvollziehen, je Kategorie ein eigener Kanal.
# In Discord: Kanal → Einstellungen → Integrationen → Webhooks → „Webhook-URL kopieren“.
# Leer = diese Kategorie geht an DISCORD_WEBHOOK_DEFAULT; ist auch das leer, wird nichts gesendet.
# Gesendet werden NIE personenbezogene Daten von Nutzern und NIE Begründungstexte —
# nur Art des Ereignisses, Fall-/Vorgangsnummer, Name der handelnden Person aus dem Team, Zeit.
DISCORD_WEBHOOK_DEFAULT=
# jede protokollierte Handlung im Werkzeug (Fälle öffnen, Sperren, Freigaben, Art. 18, Parameter …)
DISCORD_WEBHOOK_MODERATION=
# neue Meldungen, Widersprüche, Einsprüche, Anfragen an „Hilfe und Kontakt“
DISCORD_WEBHOOK_MELDUNGEN=
# Hash-Treffer, fehlgeschlagene Anmeldungen am Werkzeug, Sperre nach zu vielen Versuchen
DISCORD_WEBHOOK_SICHERHEIT=
# Anmeldungen am Werkzeug, Teamverwaltung (Zugänge angelegt/geändert/gesperrt/gelöscht)
DISCORD_WEBHOOK_TEAM=
# neue Konten, beantragte und vollzogene Löschungen (nur Anzahl, nie wer)
DISCORD_WEBHOOK_KONTEN=
# Ergebnisse der Altersprüfung, Ausweise, die ein Mensch prüfen muss
DISCORD_WEBHOOK_ALTERSPRUEFUNG=
# Serverstart, Aktualisierungen, Serverfehler, fehlgeschlagene Hintergrundaufträge
DISCORD_WEBHOOK_SYSTEM=

LOG_LEVEL=info

# Aktualisierung per Knopf (Issue #5, Werkzeug → Aktualisierung, nur Owner).
# Quelle: GitHub-Releases (Tags vX.Y.Z) dieses Repositorys. Bei einem privaten Repository ein
# Token mit Leserecht auf Inhalte (fine-grained: Contents read) eintragen.
UPDATE_REPO=liberalhenry/cruizy_backend
GITHUB_TOKEN=

# Sicherungen (deploy/backup.sh): Passwort für die Verschlüsselung der Sicherungsdateien
BACKUP_PASSPHRASE=
